generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CandidateKey {
  A
  B
  C
}

enum OrientacionForzada {
  LARGO
  ANCHO
  ALTO
}

enum PalletMixPolicy {
  NO_MEZCLAR
  PERMITIR_MEZCLA
}

enum PalletObjective {
  OPERATIVO_ESTABLE
  OPTIMIZAR_VOLUMEN
  CUIDADO_PRODUCTO
}

enum PackingPolicy {
  OPERATIVO_AGRUPADO
  OPTIMIZAR_VOLUMEN
  BUSCAR_MEJOR_ACOMODO
}

enum TipoBultoSeleccionado {
  PRODUCTO_ESTANDAR
  EMPRESA_BULTO
}

enum TipoContenedorKind {
  PALLET
  CONTENEDOR
}

enum FragilesPolicy {
  FRAGILES_ARRIBA
  PERMITIR_MEZCLA
  BLOQUEAR_MEZCLA
}

enum CubicacionLoteStatus {
  BORRADOR
  SELECCIONADO
  DESCARTADO
}

model TipoProducto {
  id                          Int       @id @default(autoincrement())
  division_servicio_id        Int
  dadora_id                   Int
  un_venta_id                 Int
  un_entrega_id               Int
  created_at                  DateTime
  updated_at                  DateTime?
  deleted_at                  DateTime?
  habilitado                  Boolean   @default(true)
  created_by                  String?
  updated_by                  String?
  codigo                      String    @unique
  descripcion                 String
  unidades_por_unidad_entrega Int

  // ✅ pesos/volúmenes como Decimal (pro)
  peso_por_unidad_venta      Decimal? @db.Decimal(10, 3)
  peso_por_unidad_entrega    Decimal? @db.Decimal(10, 3)
  volumen_por_unidad_entrega Decimal? @db.Decimal(10, 6)

  unidad_entra_por_bulto Int
  alto_por_bulto         Int
  ancho_por_bulto        Int
  largo_por_bulto        Int

  // ✅ A2
  apilable                         Boolean  @default(true)
  max_carga_superior_por_unidad_kg Decimal? @db.Decimal(10, 3)
  factor_seguridad_compresion      Decimal  @default(1.000) @db.Decimal(5, 3)

  peso_por_bulto                Decimal?                       @db.Decimal(10, 3)
  volumen_por_bulto             Decimal?                       @db.Decimal(10, 6)
  cubicacionProductoBulto       CubicacionProductoBulto?
  cubicacionProductoBultoItems  CubicacionProductoBultoItem[]
  cubicacions                   Cubicacion[]
  cubicacionProductoContenedors CubicacionProductoContenedor[]
  tipoContenedorProductos       TipoContenedorProducto[]
  divisionServicio              DivisionServicio               @relation(fields: [division_servicio_id], references: [id])
  cubicacionReglas              CubicacionRegla[]
  cubicacionConfiguracionItems  CubicacionConfiguracionItem[]
  bultoArmadoItems              BultoArmadoItem[]
  bultoArmadoPlacements         BultoArmadoPlacement[]
  cubicacionLoteItems           CubicacionLoteItem[]
  cubicacionProductoPlans       CubicacionProductoPlan[]

  // ...
  @@map("tipo_producto")
}

model CubicacionProductoBulto {
  id Int @id @default(autoincrement())

  tipo_producto_id Int          @unique
  tipoProducto     TipoProducto @relation(fields: [tipo_producto_id], references: [id])

  largo_unidad_mm Int
  ancho_unidad_mm Int
  alto_unidad_mm  Int

  grosor_pared_mm Int @default(0)

  unidades_eje_x Int
  unidades_eje_y Int
  unidades_eje_z Int

  ocupacion_interna Decimal @default(0.0) @db.Decimal(5, 2)

  orient_largo_mm Int
  orient_ancho_mm Int
  orient_alto_mm  Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items CubicacionProductoBultoItem[]

  @@map("cubicacion_producto_bulto")
}

model CubicacionProductoBultoItem {
  id Int @id @default(autoincrement())

  cubicacion_producto_bulto_id Int
  tipo_producto_id             Int

  cantidad Int

  largo_unidad_mm Int
  ancho_unidad_mm Int
  alto_unidad_mm  Int

  unidades_eje_x Int
  unidades_eje_y Int
  unidades_eje_z Int

  orient_largo_mm Int
  orient_ancho_mm Int
  orient_alto_mm  Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cubicacionProductoBulto CubicacionProductoBulto @relation(fields: [cubicacion_producto_bulto_id], references: [id], map: "cpb_item_cpb_fk")
  tipoProducto            TipoProducto            @relation(fields: [tipo_producto_id], references: [id], map: "cpb_item_tp_fk")

  @@unique([cubicacion_producto_bulto_id, tipo_producto_id], map: "cpb_item_unique")
  @@map("cubicacion_producto_bulto_item")
}

model Cubicacion {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now())
  descripcion       String?
  tipoProductoId    Int
  cantidad_unidades Int
  cantidadBultos    Int
  volumenTotalM3    Float

  packing_policy   PackingPolicy         @default(OPERATIVO_AGRUPADO)
  tipo_bulto       TipoBultoSeleccionado @default(EMPRESA_BULTO)
  bulto_empresa_id Int?

  // ✅ Relaciones (sintaxis correcta)
  tipoProducto TipoProducto  @relation(fields: [tipoProductoId], references: [id])
  bultoEmpresa EmpresaBulto? @relation(fields: [bulto_empresa_id], references: [id])

  @@index([tipoProductoId])
  @@index([bulto_empresa_id])
  @@map("cubicacion")
}

model CubicacionProductoContenedor {
  id Int @id @default(autoincrement())

  // Relación con producto y contenedor
  tipo_producto_id   Int
  tipo_contenedor_id Int

  tipoProducto   TipoProducto   @relation(fields: [tipo_producto_id], references: [id])
  tipoContenedor TipoContenedor @relation(fields: [tipo_contenedor_id], references: [id])

  // Parámetros usados en el cálculo
  altura_max_carga_m Decimal? @db.Decimal(6, 2)

  // Resultado de cubicación (bultos ↔ pallet/contenedor)
  cajas_por_capa     Int
  capas              Int
  cajas_totales      Int
  productos_por_caja Int
  productos_totales  Int
  ocupacion_volumen  Decimal @db.Decimal(5, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tipo_producto_id, tipo_contenedor_id])
  @@map("cubicacion_producto_contenedor")
}

model TipoContenedor {
  id          Int       @id @default(autoincrement())
  created_at  DateTime
  updated_at  DateTime?
  deleted_at  DateTime?
  habilitado  Boolean   @default(true)
  created_by  String?
  updated_by  String?
  codigo      String    @unique
  descripcion String

  largo_mts Float?
  ancho_mts Float?
  alto_mts  Float?

  peso_pallet_kg Float? // tara del pallet (si aplica)
  peso_max_kg    Float? // carga máx en kg (si aplica)
  peso_max_lts   Float? // carga máx en litros (si aplica)

  productos                      TipoContenedorProducto[]
  cubicacionesProductoContenedor CubicacionProductoContenedor[]
  cubicacionReglas               CubicacionRegla[]
  cubicacionConfiguracions       CubicacionConfiguracion[]
  palletizacions                 Palletizacion[]
  cubicacionPalletPlans          CubicacionPalletPlan[]

  @@map("tipo_contenedor")
}

model TipoContenedorProducto {
  tipo_contenedor_id Int
  tipo_producto_id   Int
  cantidad_max_items Int

  contenedor TipoContenedor @relation(fields: [tipo_contenedor_id], references: [id])
  producto   TipoProducto   @relation(fields: [tipo_producto_id], references: [id])

  @@id([tipo_contenedor_id, tipo_producto_id])
  @@map("tipo_contenedor_producto")
}

model DivisionServicio {
  id          Int       @id @default(autoincrement())
  created_at  DateTime  @default(now())
  updated_at  DateTime?
  deleted_at  DateTime?
  habilitado  Boolean   @default(true)
  created_by  String?
  updated_by  String?
  codigo      String    @unique
  descripcion String

  productos             TipoProducto[]
  clasificaciones       TransporteClasificacion[]
  unidadesMedidaEntrega TipoUnidadMedidaEntrega[]
  unidadesMedidaVenta   TipoUnidadMedidaVenta[]

  @@map("division_servicio")
}

model TipoUnidadMedida {
  id          Int       @id @default(autoincrement())
  created_at  DateTime  @default(now())
  updated_at  DateTime?
  deleted_at  DateTime?
  habilitado  Boolean   @default(true)
  created_by  String?
  updated_by  String?
  codigo      String    @unique
  descripcion String

  @@map("tipo_unidad_medida")
}

model TipoUnidadMedidaEntrega {
  id                   Int       @id @default(autoincrement())
  division_servicio_id Int?
  created_at           DateTime  @default(now())
  updated_at           DateTime?
  deleted_at           DateTime?
  habilitado           Boolean   @default(true)
  created_by           String?
  updated_by           String?
  codigo               String    @unique
  descripcion          String

  divisionServicio DivisionServicio? @relation(fields: [division_servicio_id], references: [id])

  @@map("tipo_unidad_medida_entrega")
}

model TipoUnidadMedidaVenta {
  id                   Int       @id @default(autoincrement())
  division_servicio_id Int?
  created_at           DateTime  @default(now())
  updated_at           DateTime?
  deleted_at           DateTime?
  habilitado           Boolean   @default(true)
  created_by           String?
  updated_by           String?
  codigo               String    @unique
  descripcion          String

  divisionServicio DivisionServicio? @relation(fields: [division_servicio_id], references: [id])

  @@map("tipo_unidad_medida_venta")
}

model TransporteClase {
  id              Int                       @id @default(autoincrement())
  codigo          String                    @unique
  descripcion     String
  clasificaciones TransporteClasificacion[]

  transportes Transporte[]

  @@map("transporte_clase")
}

model TransporteClasificacion {
  id                       Int    @id @default(autoincrement())
  clase_transporte_id      Int?
  division_servicio_id     Int
  denominacion_de_vehiculo String
  mt_largo_cub             Int
  mt_ancho_cub             Int
  mt_alto_cub              Int
  mt_total_cub             Int
  max_peso_kg              Int
  max_peso_lt              Int
  max_peso_xmt3            Int
  pallet_europaleta_total  Int
  pallet_ariog_total       String
  pallet_americano_total   String

  clase            TransporteClase? @relation(fields: [clase_transporte_id], references: [id])
  divisionServicio DivisionServicio @relation(fields: [division_servicio_id], references: [id])

  transportes      Transporte[]
  reglasCubicacion CubicacionRegla[]

  camionPlans CubicacionCamionPlan[]

  @@map("transporte_clasificacion")
}

model CubicacionRegla {
  id Int @id @default(autoincrement())

  empresaId                 Int  @map("empresa_id")
  tipoProductoId            Int? @map("tipo_producto_id")
  tipoContenedorId          Int? @map("tipo_contenedor_id")
  transporteClasificacionId Int? @map("transporte_clasificacion_id")

  maxCodigosPorPallet Int?                @map("max_codigos_por_pallet")
  maxAlturaM          Decimal?            @map("max_altura_m") @db.Decimal(6, 2)
  permitirMezcla      Boolean             @default(true) @map("permitir_mezcla")
  orientacionForzada  OrientacionForzada? @map("orientacion_forzada")
  observaciones       String?             @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  maxPesoKg        Decimal? @map("max_peso_kg") @db.Decimal(10, 2)
  maxPesoPorCapaKg Decimal? @map("max_peso_por_capa_kg") @db.Decimal(10, 2)

  fragilesPolicy         FragilesPolicy @default(FRAGILES_ARRIBA) @map("fragiles_policy")
  noPesadosSobreFragiles Boolean        @default(true) @map("no_pesados_sobre_fragiles")

  empresa                 empresa                  @relation(fields: [empresaId], references: [id])
  tipoProducto            TipoProducto?            @relation(fields: [tipoProductoId], references: [id])
  tipoContenedor          TipoContenedor?          @relation(fields: [tipoContenedorId], references: [id])
  transporteClasificacion TransporteClasificacion? @relation(fields: [transporteClasificacionId], references: [id])

  @@index([empresaId, tipoProductoId, tipoContenedorId, transporteClasificacionId], name: "idx_empresa_producto_contenedor_transporte")
  @@map("cubicacion_regla")
}

model CubicacionConfiguracion {
  id Int @id @default(autoincrement())

  created_at  DateTime @default(now())
  descripcion String?

  packing_policy   PackingPolicy         @default(OPERATIVO_AGRUPADO)
  tipo_bulto       TipoBultoSeleccionado @default(EMPRESA_BULTO)
  bulto_empresa_id Int?

  // (Opcional) a qué contenedor se palletiza
  tipo_contenedor_id Int?

  // Relaciones
  bultoEmpresa   EmpresaBulto?   @relation(fields: [bulto_empresa_id], references: [id])
  tipoContenedor TipoContenedor? @relation(fields: [tipo_contenedor_id], references: [id])

  items           CubicacionConfiguracionItem[]
  bultosArmados   BultoArmado[]
  palletizaciones Palletizacion[]

  @@index([bulto_empresa_id])
  @@index([tipo_contenedor_id])
  @@map("cubicacion_configuracion")
}

model CubicacionConfiguracionItem {
  id Int @id @default(autoincrement())

  configuracion_id Int
  tipo_producto_id Int

  cantidad_unidades Int
  volumen_unidad_m3 Float
  volumen_total_m3  Float

  // dims unidad (para reproducibilidad y auditoría)
  largo_unidad_mm Int
  ancho_unidad_mm Int
  alto_unidad_mm  Int

  configuracion CubicacionConfiguracion @relation(fields: [configuracion_id], references: [id], onDelete: Cascade)
  tipoProducto  TipoProducto            @relation(fields: [tipo_producto_id], references: [id])

  @@index([configuracion_id])
  @@index([tipo_producto_id])
  @@map("cubicacion_configuracion_item")
}

model BultoArmado {
  id Int @id @default(autoincrement())

  configuracion_id Int
  indice           Int

  tipo_bulto       TipoBultoSeleccionado
  bulto_empresa_id Int?

  // dims bulto para viewer
  largo_ext_mm Int
  ancho_ext_mm Int
  alto_ext_mm  Int

  largo_int_mm Int
  ancho_int_mm Int
  alto_int_mm  Int

  // métricas
  unidades_totales   Int
  volumen_ocupado_m3 Float
  ocupacion_pct      Float

  peso_total_kg Decimal? @db.Decimal(10, 3)

  configuracion CubicacionConfiguracion @relation(fields: [configuracion_id], references: [id], onDelete: Cascade)
  bultoEmpresa  EmpresaBulto?           @relation(fields: [bulto_empresa_id], references: [id])

  items                   BultoArmadoItem[]
  placements              BultoArmadoPlacement[]
  palletizacionPlacements PalletizacionPlacement[]

  @@unique([configuracion_id, indice])
  @@index([bulto_empresa_id])
  @@map("bulto_armado")
}

model BultoArmadoItem {
  id Int @id @default(autoincrement())

  bulto_armado_id  Int
  tipo_producto_id Int

  unidades Int

  // dims unidad (para viewer fiel)
  largo_unidad_mm Int
  ancho_unidad_mm Int
  alto_unidad_mm  Int

  peso_unidad_kg Decimal? @db.Decimal(10, 3)

  bultoArmado  BultoArmado  @relation(fields: [bulto_armado_id], references: [id], onDelete: Cascade)
  tipoProducto TipoProducto @relation(fields: [tipo_producto_id], references: [id])

  @@index([bulto_armado_id])
  @@index([tipo_producto_id])
  @@map("bulto_armado_item")
}

model BultoArmadoPlacement {
  id Int @id @default(autoincrement())

  bulto_armado_id  Int
  tipo_producto_id Int?

  codigo String @db.VarChar(100)

  // posición centro (mm) + orientación (mm)
  x_mm Float
  y_mm Float
  z_mm Float

  largo_mm Int
  ancho_mm Int
  alto_mm  Int

  bultoArmado  BultoArmado   @relation(fields: [bulto_armado_id], references: [id], onDelete: Cascade)
  tipoProducto TipoProducto? @relation(fields: [tipo_producto_id], references: [id])

  @@index([bulto_armado_id])
  @@map("bulto_armado_placement")
}

model Palletizacion {
  id Int @id @default(autoincrement())

  configuracion_id   Int
  tipo_contenedor_id Int

  created_at DateTime @default(now())

  // métricas globales
  pallets_totales      Int
  ocupacion_global_pct Float
  peso_total_kg        Decimal? @db.Decimal(10, 2)

  configuracion  CubicacionConfiguracion @relation(fields: [configuracion_id], references: [id], onDelete: Cascade)
  tipoContenedor TipoContenedor          @relation(fields: [tipo_contenedor_id], references: [id])

  pallets PalletizacionPallet[]

  @@index([configuracion_id])
  @@index([tipo_contenedor_id])
  @@map("palletizacion")
}

model PalletizacionPallet {
  id Int @id @default(autoincrement())

  palletizacion_id Int
  indice           Int

  // dims internas mm (ya convertidas y con margen aplicado)
  largo_int_mm Int
  ancho_int_mm Int
  alto_int_mm  Int

  ocupacion_pct Float
  peso_kg       Decimal? @db.Decimal(10, 2)

  palletizacion Palletizacion @relation(fields: [palletizacion_id], references: [id], onDelete: Cascade)

  placements PalletizacionPlacement[]

  @@unique([palletizacion_id, indice])
  @@map("palletizacion_pallet")
}

model PalletizacionPlacement {
  id Int @id @default(autoincrement())

  pallet_id       Int
  bulto_armado_id Int

  // posición centro (mm) + orientación del bulto (mm)
  x_mm Float
  y_mm Float
  z_mm Float

  largo_mm Int
  ancho_mm Int
  alto_mm  Int

  // capa / orden (útil para reglas “fragiles arriba”)
  capa Int

  pallet      PalletizacionPallet @relation(fields: [pallet_id], references: [id], onDelete: Cascade)
  bultoArmado BultoArmado         @relation(fields: [bulto_armado_id], references: [id])

  @@index([pallet_id])
  @@index([bulto_armado_id])
  @@map("palletizacion_placement")
}

model empresa {
  id             Int    @id @default(autoincrement())
  codigo_empresa String @db.VarChar(255)
  razon_social   String @db.VarChar(255)

  created_at DateTime  @default(now()) @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)
  habilitado Boolean   @default(true)

  // Relaciones que SÍ usamos en cubicación
  transporte       Transporte[]
  cubicacionReglas CubicacionRegla[]

  bultos                EmpresaBulto[]
  cubicacionLotes       CubicacionLote[]
  cubicacionSimulacions CubicacionSimulacion[]

  @@map("empresa")
}

model EmpresaBulto {
  id         Int       @id @default(autoincrement())
  created_at DateTime  @default(now()) @db.DateTime(0)
  updated_at DateTime  @updatedAt @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)
  habilitado Boolean   @default(true)

  empresa_id Int
  empresa    empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  codigo      String  @db.VarChar(100)
  descripcion String? @db.VarChar(255)

  largo_mm Int
  ancho_mm Int
  alto_mm  Int

  espesor_pared_mm Int @default(0)

  tara_kg     Float?
  max_peso_kg Float?

  es_preferido Boolean @default(false)

  // ... tus otros inversos

  // ✅ inverso para la FK nueva:
  cubicacionLoteItems      CubicacionLoteItem[]
  cubicacions              Cubicacion[]
  cubicacionConfiguracions CubicacionConfiguracion[]
  bultoArmados             BultoArmado[]
  cubicacionLotes          CubicacionLote[]
  cubicacionBultoPlans     CubicacionBultoPlan[]

  @@unique([empresa_id, codigo])
  @@index([empresa_id, habilitado])
  @@map("empresa_bulto")
}

model Transporte {
  id Int @id @default(autoincrement())

  empresaId                 Int  @map("empresa_id")
  claseTransporteId         Int? @map("clase_de_transporte_id")
  transporteClasificacionId Int? @map("transporte_clasificacion_id")

  dominio     String @db.VarChar(255)
  motor       String @db.VarChar(255)
  chasis      String @db.VarChar(255)
  ano         String @db.VarChar(255)
  descripcion String @db.VarChar(255)

  empresa                 empresa                  @relation(fields: [empresaId], references: [id])
  claseTransporte         TransporteClase?         @relation(fields: [claseTransporteId], references: [id])
  clasificacionTransporte TransporteClasificacion? @relation(fields: [transporteClasificacionId], references: [id])

  @@index([empresaId], map: "IDX_TRANSPORTE_EMPRESA")
  @@index([claseTransporteId], map: "IDX_336ADCB45F23D074")
  @@index([transporteClasificacionId], map: "IDX_336ADCB4CLASF")
  @@map("transporte")
}

model CubicacionLote {
  id Int @id @default(autoincrement())

  empresa_id  Int
  descripcion String?

  // NUEVO: estado + meta (existen en DB por lo que mostraste)
  status CubicacionLoteStatus @default(BORRADOR)
  meta   Json?                @db.Json

  // totales snapshot del lote (consistencia para pallet/camión)
  unidades_totales Int @default(0)
  bultos_totales   Int @default(0)

  packing_policy   PackingPolicy         @default(OPERATIVO_AGRUPADO)
  tipo_bulto       TipoBultoSeleccionado @default(EMPRESA_BULTO)
  bulto_empresa_id Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  bulto_layout Json? @db.Json

  empresa       empresa       @relation(fields: [empresa_id], references: [id])
  bulto_empresa EmpresaBulto? @relation(fields: [bulto_empresa_id], references: [id])

  items                   CubicacionLoteItem[]
  pallets                 CubicacionPalletPlan[]
  camion_plans            CubicacionCamionPlan[]
  cubicacionSimulacions   CubicacionSimulacion[]
  cubicacionProductoPlans CubicacionProductoPlan[]
  cubicacionBultoPlans    CubicacionBultoPlan[]

  @@index([empresa_id], map: "idx_lote_empresa")
  @@index([status], map: "cubicacion_lote_status_idx")
  @@map("cubicacion_lote")
}

model CubicacionLoteItem {
  id Int @id @default(autoincrement())

  lote_id          Int
  tipo_producto_id Int

  cantidad_unidades  Int
  cantidad_bultos    Int  @default(1)
  unidades_por_bulto Int?

  unidades_en_ultimo_bulto Int? @default(0)
  sobrante_unidades        Int  @default(0)

  volumen_total_m3 Float

  dim_unidad_mm  Json?  @db.Json
  peso_unidad_kg Float?

  dim_bulto_mm     Json? @db.Json
  bulto_empresa_id Int? // FK nullable

  bulto_fuente BultoFuente @default(CATALOGO)
  created_at   DateTime    @default(now())

  lote          CubicacionLote @relation(fields: [lote_id], references: [id], onDelete: Cascade)
  tipo_producto TipoProducto   @relation(fields: [tipo_producto_id], references: [id])

  // ✅ ESTA ES LA CLAVE:
  bulto_empresa EmpresaBulto? @relation(fields: [bulto_empresa_id], references: [id], onDelete: SetNull)

  @@index([lote_id], map: "idx_lote_item")
  @@index([tipo_producto_id])
  @@index([bulto_fuente], map: "idx_lote_item_bulto_fuente")
  @@index([bulto_empresa_id], map: "idx_lote_item_bulto_empresa_id")
  @@map("cubicacion_lote_item")
}

model CubicacionPalletPlan {
  id Int @id @default(autoincrement())

  loteId           Int @map("lote_id")
  tipoContenedorId Int @map("tipo_contenedor_id")

  permitir_mezcla        Boolean @default(true)
  max_codigos_por_pallet Int?
  max_altura_mm          Int?

  pallets_necesarios    Int
  ocupacion_volumen_pct Decimal @db.Decimal(5, 2)
  peso_total_kg         Float
  altura_utilizada_mm   Int

  simulacion_id Int?

  // layout completo (pallets + placements + métricas por pallet)
  layout Json @db.Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lote           CubicacionLote        @relation(fields: [loteId], references: [id], onDelete: Cascade)
  tipoContenedor TipoContenedor        @relation(fields: [tipoContenedorId], references: [id])
  simulacion     CubicacionSimulacion? @relation(fields: [simulacion_id], references: [id], onDelete: SetNull)

  candidate_key CandidateKey @default(A)

  @@unique([loteId, tipoContenedorId, candidate_key], map: "uq_lote_contenedor_candidate")
  @@index([loteId], map: "idx_pallet_plan_lote")
  @@index([simulacion_id], map: "cubicacion_pallet_plan_simulacion_id_idx")
  @@map("cubicacion_pallet_plan")
}

enum CamionStrategy {
  ESTABLE
  OPTIMIZAR
  DESCARGA_RAPIDA
}

enum CamionPlanStatus {
  BORRADOR
  SELECCIONADO
  DESCARTADO
}

enum BultoFuente {
  CATALOGO
  OPERATIVO
  EMPRESA_BULTO
}

model CubicacionCamionPlan {
  id Int @id @default(autoincrement())

  lote_id       Int
  transporte_id Int

  strategy CamionStrategy
  status   CamionPlanStatus @default(BORRADOR)

  pallets_totales     Int
  pallets_en_camion   Int
  camiones_requeridos Int
  peso_total_kg       Float
  ocupacion_base_pct  Decimal @db.Decimal(6, 2)

  layout Json

  simulacion_id Int?
  simulacion    CubicacionSimulacion? @relation(fields: [simulacion_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lote       CubicacionLote          @relation(fields: [lote_id], references: [id], onDelete: Cascade)
  transporte TransporteClasificacion @relation(fields: [transporte_id], references: [id])

  @@index([lote_id])
  @@index([transporte_id])
  @@index([lote_id, transporte_id])
  @@index([status])
  @@index([simulacion_id], map: "cubicacion_camion_plan_simulacion_id_idx")
  @@map("cubicacion_camion_plan")
}

enum CubicacionSimulacionStatus {
  BORRADOR
  SELECCIONADO
  DESCARTADO
}

model CubicacionSimulacion {
  id Int @id @default(autoincrement())

  empresa_id Int
  lote_id    Int?

  titulo      String?
  descripcion String?

  status CubicacionSimulacionStatus @default(BORRADOR)

  unidades_totales Int @default(0)
  bultos_totales   Int @default(0)

  meta Json? @db.Json

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  empresa empresa         @relation(fields: [empresa_id], references: [id])
  lote    CubicacionLote? @relation(fields: [lote_id], references: [id], onDelete: SetNull)

  productos CubicacionProductoPlan[]
  bultos    CubicacionBultoPlan[]
  pallets   CubicacionPalletPlan[]
  camiones  CubicacionCamionPlan[]

  @@index([empresa_id], map: "cubicacion_simulacion_empresa_id_idx")
  @@index([lote_id], map: "cubicacion_simulacion_lote_id_idx")
  @@index([status], map: "cubicacion_simulacion_status_idx")
  @@map("cubicacion_simulacion")
}

model CubicacionProductoPlan {
  id Int @id @default(autoincrement())

  simulacion_id Int

  tipo_producto_id Int?

  codigo      String
  descripcion String?

  cantidad_unidades  Int  @default(0)
  cantidad_bultos    Int  @default(0)
  unidades_por_bulto Int?

  unidades_en_ultimo_bulto Int? @default(0)
  sobrante_unidades        Int  @default(0)

  dim_unidad_mm  Json?  @db.Json
  peso_unidad_kg Float?

  dim_bulto_mm  Json?  @db.Json
  peso_bulto_kg Float?

  volumen_total_m3 Float @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  simulacion       CubicacionSimulacion @relation(fields: [simulacion_id], references: [id], onDelete: Cascade)
  tipo_producto    TipoProducto?        @relation(fields: [tipo_producto_id], references: [id], onDelete: SetNull)
  cubicacionLote   CubicacionLote?      @relation(fields: [cubicacionLoteId], references: [id])
  cubicacionLoteId Int?

  @@unique([simulacion_id, codigo], map: "uq_producto_plan_simulacion_codigo")
  @@index([simulacion_id], map: "cubicacion_producto_plan_simulacion_id_idx")
  @@index([tipo_producto_id], map: "cubicacion_producto_plan_tipo_producto_id_idx")
  @@map("cubicacion_producto_plan")
}

enum BultoPlanStatus {
  BORRADOR
  SELECCIONADO
  DESCARTADO
}

model CubicacionBultoPlan {
  id Int @id @default(autoincrement())

  simulacion_id Int
  lote_id       Int?

  tipo_bulto       TipoBultoSeleccionado @default(EMPRESA_BULTO)
  bulto_empresa_id Int?

  unidades_totales Int @default(0)
  bultos_totales   Int @default(0)

  status BultoPlanStatus @default(BORRADOR)

  layout Json @db.Json

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  simulacion    CubicacionSimulacion @relation(fields: [simulacion_id], references: [id], onDelete: Cascade)
  lote          CubicacionLote?      @relation(fields: [lote_id], references: [id], onDelete: SetNull)
  bulto_empresa EmpresaBulto?        @relation(fields: [bulto_empresa_id], references: [id], onDelete: SetNull)

  @@index([simulacion_id], map: "cubicacion_bulto_plan_simulacion_id_idx")
  @@index([status], map: "cubicacion_bulto_plan_status_idx")
  @@map("cubicacion_bulto_plan")
}
